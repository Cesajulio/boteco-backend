{
  "openapi": "3.0.3",
  "info": {
    "title": "API do Boteco",
    "version": "2.0.0",
    "description": "Contrato formal OpenAPI 3.0 da API REST do Boteco em Arquitetura em Camadas. Oferece localização geoespacial de bares, CRUD completo, monitoramento de preços com média aritmética real acumulada e histórico, avaliações de clientes, ranking de menor preço, autenticação JWT com Refresh Token e revogação no Redis, validação Zod e respostas de erro padronizadas (RFC 7807).",
    "contact": {
      "name": "Equipe Boteco API"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor atual (VPS / Local - rotas padrão)"
    },
    {
      "url": "/api/v1",
      "description": "Servidor atual (VPS / Local - prefixo versionado v1)"
    }
  ],
  "tags": [
    { "name": "Observabilidade", "description": "Health checks (readiness/liveness) e métricas operacionais da API" },
    { "name": "Autenticação", "description": "Registro, login, refresh token, perfil autenticado e logout com revogação" },
    { "name": "Bares", "description": "Consulta paginada/geoespacial, busca, ranking e CRUD completo de bares" },
    { "name": "Preços", "description": "Atualização de preços médios com idempotência e histórico" },
    { "name": "Avaliações", "description": "Avaliações e notas de clientes sobre bares" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access Token JWT obtido em POST /auth/login ou POST /auth/register."
      }
    },
    "headers": {
      "CorrelationId": {
        "description": "Identificador de correlação propagado nos logs e respostas.",
        "schema": { "type": "string", "format": "uuid" }
      },
      "XCache": {
        "description": "Indica se a resposta veio do cache Redis (HIT) ou do Firestore (MISS).",
        "schema": { "type": "string", "enum": ["HIT", "MISS"] }
      },
      "IdempotencyReplayed": {
        "description": "Presente com valor 'true' quando a resposta é um replay idempotente do Redis.",
        "schema": { "type": "string", "example": "true" }
      },
      "Location": {
        "description": "URI do recurso recém-criado.",
        "schema": { "type": "string", "example": "/bars/bar-001" }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 4, "example": "req-unique-2026-001" },
        "description": "Chave única para garantir idempotência da operação (armazenada no Redis por 24h com validação de hash SHA-256 do payload)."
      },
      "BarId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "example": "bar-123" },
        "description": "Identificador único do bar no Firestore."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisição inválida ou erro de validação de entrada (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Unauthorized": {
        "description": "Não autenticado — token ausente, inválido, expirado ou revogado (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Forbidden": {
        "description": "Acesso negado — papel (RBAC) insuficiente para a operação (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "NotFound": {
        "description": "Recurso não encontrado (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "Conflict": {
        "description": "Conflito de estado — usuário duplicado ou reuso divergente de Idempotency-Key (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      },
      "TooManyRequests": {
        "description": "Limite de requisições excedido (Rate Limiting) (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "instance"],
        "description": "Formato padronizado de erro conforme RFC 7807",
        "properties": {
          "type": { "type": "string", "example": "https://httpstatuses.com/400" },
          "title": { "type": "string", "example": "Validation Error" },
          "status": { "type": "integer", "example": 400 },
          "detail": { "type": "string", "example": "Dados de entrada inválidos. Verifique os campos informados." },
          "instance": { "type": "string", "example": "/bars" },
          "correlationId": { "type": "string", "example": "9c3d4f82-8421-4be9-a45b-02a90633f3b7" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "location": { "type": "string", "enum": ["body", "query", "params"], "example": "body" },
                "field": { "type": "string", "example": "price" },
                "message": { "type": "string", "example": "O preço deve ser maior que zero." }
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service", "version", "timestamp", "uptimeSeconds", "dependencies"],
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded", "unhealthy"], "example": "ok" },
          "service": { "type": "string", "example": "boteco-backend" },
          "version": { "type": "string", "example": "2.0.0" },
          "timestamp": { "type": "string", "format": "date-time" },
          "uptimeSeconds": { "type": "integer", "example": 3600 },
          "dependencies": {
            "type": "object",
            "properties": {
              "firestore": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "up" },
                  "connected": { "type": "boolean", "example": true },
                  "latencyMs": { "type": "number", "example": 45 }
                }
              },
              "redis": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "example": "up" },
                  "connected": { "type": "boolean", "example": true },
                  "mode": { "type": "string", "example": "redis" },
                  "latencyMs": { "type": "number", "example": 2 }
                }
              }
            }
          }
        }
      },
      "LivenessResponse": {
        "type": "object",
        "required": ["status", "service", "version", "uptimeSeconds"],
        "properties": {
          "status": { "type": "string", "example": "alive" },
          "service": { "type": "string", "example": "boteco-backend" },
          "version": { "type": "string", "example": "2.0.0" },
          "uptimeSeconds": { "type": "integer", "example": 120 }
        }
      },
      "MetricsResponse": {
        "type": "object",
        "properties": {
          "service": { "type": "string", "example": "boteco-backend" },
          "version": { "type": "string", "example": "2.0.0" },
          "startedAt": { "type": "string", "format": "date-time" },
          "uptimeSeconds": { "type": "integer", "example": 3600 },
          "requests": {
            "type": "object",
            "properties": {
              "total": { "type": "integer", "example": 128 },
              "byStatusClass": { "type": "object" },
              "averageLatencyMs": { "type": "number", "example": 14.32 }
            }
          },
          "cache": {
            "type": "object",
            "properties": {
              "hits": { "type": "integer", "example": 85 },
              "misses": { "type": "integer", "example": 15 },
              "hitRatePercent": { "type": "number", "example": 85 }
            }
          },
          "idempotency": {
            "type": "object",
            "properties": {
              "replays": { "type": "integer", "example": 4 }
            }
          },
          "memoryMb": {
            "type": "object",
            "properties": {
              "rss": { "type": "number", "example": 64.5 },
              "heapUsed": { "type": "number", "example": 28.1 },
              "heapTotal": { "type": "number", "example": 42.0 }
            }
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": ["id", "username", "name", "role"],
        "properties": {
          "id": { "type": "string", "example": "demo-admin" },
          "username": { "type": "string", "example": "admin" },
          "name": { "type": "string", "example": "Administrador Boteco" },
          "role": { "type": "string", "enum": ["admin", "cliente"] },
          "email": { "type": "string", "format": "email", "example": "admin@boteco.com" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["token", "accessToken", "refreshToken", "tokenType", "expiresIn", "role", "user"],
        "properties": {
          "token": { "type": "string", "description": "Alias retrocompatível de accessToken" },
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "tokenType": { "type": "string", "example": "Bearer" },
          "expiresIn": { "type": "string", "example": "1h" },
          "role": { "type": "string", "enum": ["admin", "cliente"] },
          "user": { "$ref": "#/components/schemas/UserProfile" }
        }
      },
      "Bar": {
        "type": "object",
        "required": ["id", "name", "latitude", "longitude"],
        "properties": {
          "id": { "type": "string", "example": "bar-001" },
          "name": { "type": "string", "example": "Boteco do Zé" },
          "address": { "type": "string", "example": "Rua das Flores, 123 - Centro" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90, "example": -15.793889 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180, "example": -47.882778 },
          "phone": { "type": "string", "example": "(61) 99999-0000" },
          "openingHours": { "type": "string", "example": "Ter-Dom 17h às 01h" },
          "averageBeerPrice": { "type": "number", "example": 12.5 },
          "averageWaterPrice": { "type": "number", "example": 5.0 },
          "averageDrinkPrice": { "type": "number", "example": 18.0 },
          "averageRating": { "type": "number", "minimum": 0, "maximum": 5, "example": 4.7 },
          "reviewsCount": { "type": "integer", "example": 14 },
          "tags": { "type": "array", "items": { "type": "string" }, "example": ["samba", "petiscos"] },
          "distance": { "type": "number", "description": "Distância em metros (presente em buscas por proximidade)", "example": 420 },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "BarCreateInput": {
        "type": "object",
        "required": ["name", "address", "latitude", "longitude"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120, "example": "Boteco da Esquina" },
          "address": { "type": "string", "minLength": 5, "maxLength": 250, "example": "Av. Brasil, 450 - Centro" },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90, "example": -15.7942 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180, "example": -47.8822 },
          "phone": { "type": "string", "maxLength": 30, "example": "(61) 98888-1234" },
          "openingHours": { "type": "string", "maxLength": 120, "example": "Seg-Dom 16h às 00h" },
          "averageBeerPrice": { "type": "number", "minimum": 0, "maximum": 1000, "example": 11.5 },
          "averageWaterPrice": { "type": "number", "minimum": 0, "maximum": 1000, "example": 4.5 },
          "averageDrinkPrice": { "type": "number", "minimum": 0, "maximum": 1000, "example": 16.0 },
          "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 10, "example": ["cerveja-gelada", "musica-ao-vivo"] }
        }
      },
      "BarUpdateInput": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 120 },
          "address": { "type": "string", "minLength": 5, "maxLength": 250 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "phone": { "type": "string", "maxLength": 30 },
          "openingHours": { "type": "string", "maxLength": 120 },
          "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 10 }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["page", "limit", "total", "totalPages"],
        "properties": {
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "total": { "type": "integer", "example": 42 },
          "totalPages": { "type": "integer", "example": 3 }
        }
      },
      "PriceUpdateResponse": {
        "type": "object",
        "required": ["message", "updatedField", "newAveragePrice", "reportsCount", "recordedAt"],
        "properties": {
          "message": { "type": "string", "example": "Preço atualizado com sucesso." },
          "updatedField": { "type": "string", "example": "averageBeerPrice" },
          "newAveragePrice": { "type": "number", "example": 12.75 },
          "reportsCount": { "type": "integer", "example": 4 },
          "recordedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PriceHistoryEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "productId": { "type": "string", "enum": ["cerveja-600", "agua-500", "long-neck", "caipirinha"] },
          "targetField": { "type": "string", "example": "averageBeerPrice" },
          "reportedPrice": { "type": "number", "example": 13.0 },
          "resultingAverage": { "type": "number", "example": 12.75 },
          "reportedBy": { "type": "string", "example": "admin" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
          "comment": { "type": "string", "example": "Cerveja trincando e ótimo atendimento!" },
          "authorUsername": { "type": "string", "example": "cliente" },
          "authorName": { "type": "string", "example": "Cliente Boteco" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Observabilidade"],
        "summary": "Readiness check — verifica saúde da API e dependências (Firestore e Redis)",
        "responses": {
          "200": {
            "description": "Serviço operacional (ou degradado com fallback em memória)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "503": {
            "description": "Dependência crítica (Firestore) indisponível",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": ["Observabilidade"],
        "summary": "Liveness probe leve para Docker HEALTHCHECK / orquestradores",
        "responses": {
          "200": {
            "description": "Processo da API ativo",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LivenessResponse" } } }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "tags": ["Observabilidade"],
        "summary": "Retorna métricas operacionais (requisições, latência média, cache hit rate e memória)",
        "responses": {
          "200": {
            "description": "Métricas coletadas com sucesso",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MetricsResponse" } } }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "registerUser",
        "tags": ["Autenticação"],
        "summary": "Registrar novo usuário (papel padrão: cliente)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "name", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 3, "maxLength": 50, "example": "joao.silva" },
                  "name": { "type": "string", "minLength": 2, "maxLength": 100, "example": "João Silva" },
                  "email": { "type": "string", "format": "email", "example": "joao@example.com" },
                  "password": { "type": "string", "minLength": 6, "maxLength": 100, "example": "senhaSegura123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado e autenticado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "loginUser",
        "tags": ["Autenticação"],
        "summary": "Autenticar usuário e emitir Access Token + Refresh Token",
        "description": "Aceita usuários cadastrados no Firestore ou as credenciais de demonstração admin/admin e cliente/cliente.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "admin" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticado com sucesso",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshToken",
        "tags": ["Autenticação"],
        "summary": "Renovar Access Token usando Refresh Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Novos tokens emitidos",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutUser",
        "tags": ["Autenticação"],
        "summary": "Encerrar sessão e revogar o Access Token atual no Redis",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Token revogado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "Logout realizado com sucesso. Token revogado." },
                    "revokedUntil": { "type": "string", "format": "date-time", "nullable": true }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["Autenticação"],
        "summary": "Retorna dados do usuário autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Perfil do usuário autenticado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserProfile" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/bars": {
      "get": {
        "operationId": "listBars",
        "tags": ["Bares"],
        "summary": "Listar bares ou buscar bares próximos com filtros, ordenação e paginação",
        "description": "Se lat, lng e radius forem informados juntos, filtra bares dentro do raio e ordena por distância por padrão. Se omitidos, retorna todos os bares paginados. Utiliza cache Redis (header X-Cache: HIT|MISS).",
        "parameters": [
          { "name": "lat", "in": "query", "required": false, "schema": { "type": "number", "minimum": -90, "maximum": 90, "example": -15.7938 } },
          { "name": "lng", "in": "query", "required": false, "schema": { "type": "number", "minimum": -180, "maximum": 180, "example": -47.8827 } },
          { "name": "radius", "in": "query", "required": false, "schema": { "type": "number", "minimum": 0.1, "maximum": 500, "example": 5 }, "description": "Raio em km (máx. 500)" },
          { "name": "maxBeerPrice", "in": "query", "required": false, "schema": { "type": "number", "example": 15 } },
          { "name": "sortBy", "in": "query", "required": false, "schema": { "type": "string", "enum": ["distance", "averageBeerPrice", "averageWaterPrice", "averageDrinkPrice", "averageRating", "name"] } },
          { "name": "order", "in": "query", "required": false, "schema": { "type": "string", "enum": ["asc", "desc"], "default": "asc" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de bares",
            "headers": {
              "X-Cache": { "$ref": "#/components/headers/XCache" },
              "Correlation-Id": { "$ref": "#/components/headers/CorrelationId" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data", "pagination"],
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Bar" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "operationId": "createBar",
        "tags": ["Bares"],
        "summary": "Cadastrar um novo bar (somente admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BarCreateInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bar cadastrado com sucesso",
            "headers": {
              "Location": { "$ref": "#/components/headers/Location" },
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bar" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/bars/search": {
      "get": {
        "operationId": "searchBars",
        "tags": ["Bares"],
        "summary": "Pesquisar bares por nome, endereço ou tags (insensível a acentos)",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "example": "ze" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Resultados da busca",
            "headers": { "X-Cache": { "$ref": "#/components/headers/XCache" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data", "meta"],
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Bar" } },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "query": { "type": "string" },
                        "totalMatches": { "type": "integer" },
                        "returned": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/bars/ranking": {
      "get": {
        "operationId": "getCheapestBarsRanking",
        "tags": ["Bares"],
        "summary": "Ranking dos bares mais baratos para um produto",
        "parameters": [
          { "name": "product", "in": "query", "required": false, "schema": { "type": "string", "enum": ["cerveja-600", "agua-500", "long-neck", "caipirinha"], "default": "cerveja-600" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Ranking ordenado pelo menor preço",
            "headers": { "X-Cache": { "$ref": "#/components/headers/XCache" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["product", "priceField", "data"],
                  "properties": {
                    "product": { "type": "string", "example": "cerveja-600" },
                    "priceField": { "type": "string", "example": "averageBeerPrice" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rank": { "type": "integer", "example": 1 },
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "address": { "type": "string", "nullable": true },
                          "product": { "type": "string" },
                          "priceField": { "type": "string" },
                          "price": { "type": "number", "example": 8.5 },
                          "averageRating": { "type": "number", "example": 4.9 }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/bars/{id}": {
      "get": {
        "operationId": "getBarById",
        "tags": ["Bares"],
        "summary": "Obter detalhes de um bar pelo ID",
        "parameters": [{ "$ref": "#/components/parameters/BarId" }],
        "responses": {
          "200": {
            "description": "Bar encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bar" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updateBar",
        "tags": ["Bares"],
        "summary": "Atualizar dados de um bar (somente admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/BarId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BarUpdateInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bar atualizado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Bar" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "operationId": "deleteBar",
        "tags": ["Bares"],
        "summary": "Remover um bar (somente admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/BarId" }],
        "responses": {
          "204": { "description": "Bar removido com sucesso" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/bars/{id}/prices": {
      "post": {
        "operationId": "updateBarProductPrice",
        "tags": ["Preços"],
        "summary": "Registrar novo preço de produto e recalcular média real acumulada (somente admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/BarId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId", "price"],
                "properties": {
                  "productId": { "type": "string", "enum": ["cerveja-600", "agua-500", "long-neck", "caipirinha"], "example": "cerveja-600" },
                  "price": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000, "example": 12.5 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preço atualizado e histórico registrado",
            "headers": {
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PriceUpdateResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/bars/{id}/prices/history": {
      "get": {
        "operationId": "getBarPriceHistory",
        "tags": ["Preços"],
        "summary": "Consultar histórico de preços registrados de um bar",
        "parameters": [
          { "$ref": "#/components/parameters/BarId" },
          { "name": "productId", "in": "query", "required": false, "schema": { "type": "string", "enum": ["cerveja-600", "agua-500", "long-neck", "caipirinha"] } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Histórico retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["barId", "barName", "total", "data"],
                  "properties": {
                    "barId": { "type": "string" },
                    "barName": { "type": "string" },
                    "total": { "type": "integer" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/PriceHistoryEntry" } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/bars/{id}/reviews": {
      "get": {
        "operationId": "getBarReviews",
        "tags": ["Avaliações"],
        "summary": "Listar avaliações de um bar",
        "parameters": [
          { "$ref": "#/components/parameters/BarId" },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Avaliações do bar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["barId", "barName", "averageRating", "reviewsCount", "data"],
                  "properties": {
                    "barId": { "type": "string" },
                    "barName": { "type": "string" },
                    "averageRating": { "type": "number" },
                    "reviewsCount": { "type": "integer" },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Review" } }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "createBarReview",
        "tags": ["Avaliações"],
        "summary": "Publicar avaliação de um bar (usuário autenticado: cliente ou admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/BarId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["rating"],
                "properties": {
                  "rating": { "type": "integer", "minimum": 1, "maximum": 5, "example": 5 },
                  "comment": { "type": "string", "maxLength": 500, "example": "Cerveja trincando e ótimo atendimento!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Avaliação registrada e nota média recalculada",
            "headers": {
              "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["review", "barRatingSummary"],
                  "properties": {
                    "review": { "$ref": "#/components/schemas/Review" },
                    "barRatingSummary": {
                      "type": "object",
                      "properties": {
                        "averageRating": { "type": "number", "example": 4.8 },
                        "reviewsCount": { "type": "integer", "example": 15 }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    }
  }
}
