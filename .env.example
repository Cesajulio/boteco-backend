# Configurações do Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*
# URL pública na VPS para o Swagger UI (opcional; padrão usa URL relativa '/')
# PUBLIC_URL=http://SEU_IP_VPS:3000
ENABLE_HSTS=false

# Autenticação JWT (Em produção, utilize chaves fortes e aleatórias)
JWT_SECRET=super-secret-key-boteco-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super-secret-refresh-key-boteco-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Cache, Idempotência, Rate Limiting e Revogação de Tokens)
# Quando executado com docker-compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Firebase Firestore
FIREBASE_KEY_PATH=./firebase-key.json
# Alternativa para deploy em nuvem (JSON da service account serializado):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Rate Limiting e Cache
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15
BARS_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400
